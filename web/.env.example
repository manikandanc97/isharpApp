# Production NestJS API origin: https://isharpapp.onrender.com
# For local NestJS backend development, set to http://localhost:3001
API_BASE_URL=https://isharpapp.onrender.com
NEXT_PUBLIC_API_URL=https://isharpapp.onrender.com

# Public Supabase browser configuration used by @supabase/ssr.
# Never expose a secret key, service-role key, Google client secret, or JWT secret here.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<public-anon-or-publishable-key>
