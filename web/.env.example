# Server-only NestJS API origin. Do not prefix this with NEXT_PUBLIC_.
API_BASE_URL=http://localhost:3001

# Public Supabase browser configuration. Never expose a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<public-anon-or-publishable-key>
