# Server-only NestJS API origin. Do not prefix this with NEXT_PUBLIC_.
API_BASE_URL=http://localhost:3001
# Public Supabase browser configuration used by @supabase/ssr.
# The publishable key may be placed in the existing ANON_KEY variable.
# Never expose a secret key, service-role key, Google client secret, or JWT secret here.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<public-anon-or-publishable-key>
