# Application
NODE_ENV=development
PORT=3001
FRONTEND_LOCAL_ORIGIN=http://localhost:3000
FRONTEND_PRODUCTION_ORIGIN=https://academy.example.com
# Disabled by default. May only be true with NODE_ENV=development.
DUMMY_AUTH_ENABLED=false
# Required only when dummy auth is enabled; choose a unique 12+ character value.
DUMMY_AUTH_PASSWORD=<local-development-password>

# PostgreSQL / Prisma
# Supabase Transaction Pooler (port 6543) for runtime API execution
DATABASE_URL=postgresql://<user>:<url-encoded-password>@<host>:6543/<database>?sslmode=require
# Supabase Direct Connection (port 5432) for Prisma CLI migrations
DIRECT_URL=postgresql://<user>:<url-encoded-password>@<host>:5432/<database>?sslmode=require
# Database connection pool sizing (Recommended: 8 for single container, 5 for multi-instance cluster)
DATABASE_POOL_MAX=8
DATABASE_POOL_MIN=1

# Supabase server configuration
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<project-anon-or-publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<server-side-service-role-key>
QUESTION_MEDIA_BUCKET=question-media
SUPABASE_JWT_AUDIENCE=authenticated
# For legacy HS256 projects only; prefer Supabase JWKS.
# SUPABASE_JWT_SECRET=<legacy-jwt-secret-at-least-32-characters>

# Optional NestJS Observe configuration
# OBSERVE_APP_KEY=<observe-app-key>
# OBSERVE_APP_SECRET=<observe-app-secret>

# Initial-admin setup. Never commit real credentials.
INITIAL_SUPERADMIN_EMAIL=<super-admin-email-address>
INITIAL_SUPERADMIN_PASSWORD=<unique-strong-initial-password>
INITIAL_SUPERADMIN_DISPLAY_NAME=<super-admin-display-name>
INITIAL_ADMIN_EMAIL=<admin-email-address>
INITIAL_ADMIN_PASSWORD=<different-unique-strong-initial-password>
INITIAL_ADMIN_DISPLAY_NAME=<admin-display-name>
