# Isolated Integration & Concurrency Test Environment Template
# NEVER reuse production credentials or point to a production Supabase/PostgreSQL host.
# Integration suites MUST fail closed if DATABASE_URL targets a non-local/non-staging host.

NODE_ENV=test
ALLOW_MOCK_DEMO_OTP=true

# Dedicated local PostgreSQL or isolated Supabase branch/staging project
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/isharp_test"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/isharp_test"
DATABASE_POOL_MAX=5

# Isolated test auth & storage configuration (synthetic fixtures only)
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_ANON_KEY="replace-with-local-test-anon-key"
SUPABASE_JWT_SECRET="replace-with-local-test-jwt-secret"
DEMO_VISITOR_SECRET="local-test-demo-visitor-signing-secret"
